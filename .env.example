# ==============================================================================
# INSURRA Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the backend or frontend:
#   cp .env.example .env
# ==============================================================================

# Database Persistence
# Database connection string consumed by SQLAlchemy 2 in backend/app/core/config.py.
# Default uses local SQLite. For PostgreSQL, set postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Frontend and CORS Origins
# Consumed in backend/app/main.py for CORS validation. Must be an explicit origin (not *).
FRONTEND_ORIGIN=http://localhost:3000

# Consumed in frontend/src/lib/config.ts to direct API requests to the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URLs for callback and redirect building
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000

# Application Environment (development, test, production)
ENVIRONMENT=development

# AI Provider Configuration
# Set to 'gemini' (default) or 'openai'. Consumed in backend/app/services/ai_gateway.py.
AI_PROVIDER=gemini

# Google Gemini API Settings (Optional for demo mode; required for live AI features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# OpenAI API Settings (Alternative AI provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_FAST_MODEL=gpt-6-luna

# Knowledge Base Country Scope
# Comma-separated ISO country codes to enable. Consumed in backend/app/core/config.py.
ACTIVE_KB_COUNTRIES=CN,ID

# Demo and Account Session Lifetimes
# Ephemeral demo session time-to-live in hours (default: 24)
SESSION_TTL_HOURS=24

# Authenticated account session time-to-live in days (default: 7)
ACCOUNT_SESSION_TTL_DAYS=7

# Secret key used for signing session tokens and cryptographic receipts
SESSION_SECRET=

# Google OAuth 2.0 (Optional in demo mode; required for live Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Supabase Auth Integration (Optional alternative for OAuth routing)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email Delivery Configuration (Optional for development; logs to console if enabled)
# Set EMAIL_DELIVERY_ENABLED=true and SMTP_HOST=console to log verification links to terminal.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=console
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@insurra.com
SMTP_FROM_NAME=Insurra
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Sandbox and Workflow Background Worker Settings
SANDBOX_STEP_SECONDS=10
CLAIM_POLL_INTERVAL_SECONDS=0
CLAIM_POLL_LIMIT=60
AGENT_WORKER_ENABLED=false
AGENT_WORKER_INTERVAL_SECONDS=15
FREEZE_LEGACY_ACTIONS=false
