DATABASE_URL=sqlite:///./dev.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_FAST_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENVIRONMENT=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000
SESSION_SECRET=
ACCOUNT_SESSION_TTL_DAYS=7
ACTIVE_KB_COUNTRIES=CN,ID

# Supabase Auth (Google OAuth via Supabase)
# Set SUPABASE_URL and SUPABASE_ANON_KEY to route Google Sign In/Register through Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email Delivery (verification and password reset)
# Set EMAIL_DELIVERY_ENABLED=true and SMTP_HOST=console to log verification and reset links directly to stdout/terminal in development
# Or configure SMTP credentials (e.g. Gmail, Resend, Brevo, AWS SES) for live inbox delivery:
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=console
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@insurra.com
SMTP_FROM_NAME=Insurra
SMTP_USE_TLS=true
SMTP_USE_SSL=false
